# Copy to .env.local and fill in. .env.local is git-ignored and must never be
# committed. Every integration is built to degrade to a local stub when its key
# is absent, so development works with this file untouched.

# Public site origin, used for canonical URLs, OpenGraph and sitemap output.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Brief form delivery (Phase 7) -----------------------------------------
# Transactional email for brief submissions and the autoresponder. Sent over
# Resend's REST API, so no SDK is installed. All three of these are required
# together: a key without addresses is refused rather than silently delivering
# nowhere.
RESEND_API_KEY=
# Must be on a domain verified in Resend, or sending is rejected.
BRIEF_FROM_EMAIL=
# Where enquiries land.
BRIEF_TO_EMAIL=

# Incoming webhook that mirrors each submission into the studio Slack channel.
SLACK_BRIEF_WEBHOOK=

# Cloudflare Turnstile. The site key is public by design; the secret is not.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Signed upload target for the optional brief attachment.
BLOB_READ_WRITE_TOKEN=

# --- Analytics (NFR-14) -----------------------------------------------------
# Where the eleven named events are posted. Cookieless and identifier-free by
# construction — see src/lib/analytics.ts. Left blank, nothing is sent at all,
# so the call sites are instrumented and the destination stays a deployment
# decision. Point it at a Plausible or Vercel endpoint, or your own collector.
NEXT_PUBLIC_ANALYTICS_URL=

# --- Rate limiting (Phase 7) ------------------------------------------------
# Vercel KV is retired, so the limiter targets Upstash Redis. Left blank, the
# limiter falls back to an in-memory implementation for local development.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
